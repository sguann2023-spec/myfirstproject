{
  "name": "@sun-guannan/vectcut",
  "version": "1.5.2",
  "description": "VectCut Application",
  "main": "./out/main/index.js",
  "scripts": {
    "start": "electron-vite preview",
    "dev": "electron-vite",
    "debug:vite": "electron-vite -- --inspect --sourcemap --remote-debugging-port=9222",
    "prepare:portable-git:win": "node ./util/prepare-portable-git.js",
    "build:vite": "electron-vite build",
    "build:main": "tsc -p tsconfig.main.json --noEmitOnError false || true && tsc-alias -p tsconfig.main.json && node -e \"const fs=require('fs');const path=require('path');const src=path.join(process.cwd(),'src/main/integration/nutstore/sso/lib/index.mjs');const dst=path.join(process.cwd(),'dist-main/src/main/integration/nutstore/sso/lib/index.mjs');fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);\"",
    "build": "pnpm run build:vite && electron-builder --mac dmg zip --universal && pnpm run prepare:portable-git:win && electron-builder --win",
    "build:mac": "pnpm run build:vite && electron-builder --mac dmg zip --universal",
    "build:mac:ci": "pnpm run build:vite && electron-builder --mac dmg zip --x64 --arm64 --publish never --config.mac.forceCodeSigning=true",
    "build:mac:arm64": "pnpm run build:vite && electron-builder --mac dmg zip --arm64",
    "build:win": "pnpm run build:vite && pnpm run prepare:portable-git:win && electron-builder --win",
    "build:win:x64": "ELECTRON_MIRROR=https://cdn.npmmirror.com/binaries/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://cdn.npmmirror.com/binaries/electron-builder/ env -u HTTP_PROXY -u http_proxy -u HTTPS_PROXY -u https_proxy -u ALL_PROXY -u all_proxy pnpm run build:vite && pnpm run prepare:portable-git:win && electron-builder --win --x64",
    "dev-start": "pnpm run dev",
    "test": "echo \"No tests specified\" && exit 0",
    "preinstall": "node -e \"const ua=process.env.npm_config_user_agent||'';if(!ua.includes('pnpm')){console.error('Please use pnpm to install dependencies.');process.exit(1)}\"",
    "postinstall": "patch-package"
  },
  "build": {
    "appId": "com.vectcut.app",
    "productName": "流光剪辑",
    "icon": "src/logo.png",
    "protocols": {
      "name": "vectcut",
      "schemes": [
        "vectcut",
        "cherrystudio"
      ]
    },
    "asar": true,
    "directories": {
      "output": "build"
    },
    "files": [
      "out/**/*",
      "node_modules/**/*",
      "package.json",
      "locales/**/*",
      "src/logo.png",
      "src/**/*",
      "public/**/*",
      "util/**/*",
      "template/**/*",
      "template_jianying/**/*"
    ],
    "extraResources": [
      {
        "from": "./resources",
        "to": "resources",
        "filter": [
          "**/*",
          "!gitbash/**/*.7z.exe"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build-resources/entitlements.mac.plist",
      "entitlementsInherit": "build-resources/entitlements.mac.inherit.plist",
      "mergeASARs": false,
      "asarUnpack": [
        "**/*.node"
      ],
      "x64ArchFiles": "**/node_modules/**/*",
      "icon": "src/logo.icns",
      "artifactName": "VectCut-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "linux": {
      "target": []
    },
    "win": {
      "icon": "src/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VectCut-Setup-${version}-${arch}.exe",
      "executableName": "VectCut",
      "extraResources": [
        {
          "from": "locales",
          "to": "locales"
        },
        {
          "from": "skills",
          "to": "skills"
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": "always",
      "shortcutName": "流光剪辑",
      "uninstallDisplayName": "流光剪辑"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "sun-guannan",
        "repo": "CapCutMaker"
      }
    ]
  },
  "keywords": [
    "capcutapi",
    "VectCut",
    "electron",
    "desktop"
  ],
