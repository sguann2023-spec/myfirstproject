{
  "name": "@sun-guannan/capcutmaker",
  "version": "1.3.1",
  "description": "CapCut Helper Application",
  "main": "main.js",
  "scripts": {
    "start": "NODE_ENV=development electron .",
    "debug": "electron --inspect=9229 .",
    "build": "webpack --mode production && electron-builder --mac --win",
    "build:mac": "webpack --mode production && electron-builder --mac",
    "build:win": "webpack --mode production && electron-builder --win",
    "build:win:x64": "ELECTRON_MIRROR=https://cdn.npmmirror.com/binaries/electron/ ELECTRON_BUILDER_BINARIES_MIRROR=https://cdn.npmmirror.com/binaries/electron-builder/ env -u HTTP_PROXY -u http_proxy -u HTTPS_PROXY -u https_proxy -u ALL_PROXY -u all_proxy webpack --mode production && electron-builder --win --x64",
    "dev": "webpack --watch",
    "dev-start": "concurrently \"npm run dev\" \"npm run start\"",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "build": {
    "appId": "com.capcutapi.app",
    "productName": "流光剪辑",
    "icon": "src/logo.png",
    "protocols": {
      "name": "capcutmaker",
      "schemes": [
        "capcutmaker"
      ]
    },
    "asar": true,
    "directories": {
      "output": "build"
    },
    "files": [
      "dist/**/*",
      "main.js",
      "package.json",
      "locales/**/*",
      "src/logo.png",
      "src/**/*",
      "public/**/*",
      "util/**/*",
      "template/**/*",
      "template_jianying/**/*"
    ],
    "extraResources": [
      {
        "from": "./resources",
        "to": "resources",
        "filter": [
          "**/*"
        ]
      }
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "asarUnpack": [
        "**/*.node"
      ],
      "icon": "src/logo.icns",
      "artifactName": "VectCut-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ]
    },
    "linux": {
      "target": []
    },
    "win": {
      "icon": "src/logo.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "artifactName": "VectCut-Setup-${version}-${arch}.exe",
      "executableName": "VectCut",
      "extraResources": [
        { "from": "locales", "to": "locales" }
      ]
    },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": "always",
      "shortcutName": "流光剪辑",
      "uninstallDisplayName": "流光剪辑"
    },
    "publish": [
      { "provider": "github", "owner": "sun-guannan", "repo": "CapCutMaker" }
    ]
  },
  "keywords": [
    "capcutapi",
    "VectCut",
    "electron",
    "desktop"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@ant-design/icons": "^5.2.6",
    "@authing/guard-react": "^5.3.9",
    "adm-zip": "^0.5.16",
    "antd": "^5.27.0",
    "axios": "^1.13.2",
    "electron-log": "^5.4.3",
    "electron-reload": "^2.0.0-alpha.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "fs-extra": "^11.3.1",
    "i18next": "^25.3.6",
    "i18next-fs-backend": "^2.6.0",
    "i18next-http-backend": "^3.0.2",
    "mobx": "^6.15.0",
    "mobx-react-lite": "^4.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^15.6.1",
    "react-router-dom": "^7.9.6"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^13.0.1",
    "css-loader": "^6.8.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12",
    "html-webpack-plugin": "^5.5.3",
    "javascript-obfuscator": "^4.1.1",
    "style-loader": "^3.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-obfuscator": "^3.5.1"
  }
}
